############################
# Unreal Engine (generated)
############################
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Tools: ignored by default (Blender files, screenshots, icon dumps, backups...).
# Opt folders back in below. Git can't re-include a file whose parent folder is
# excluded, so each level is "ignore contents" + "un-ignore the one we want".
/Tools/*
!/Tools/add_gameplay_tag.py
!/Tools/add_gameplay_tag_howto.txt
!/Tools/MasterDatabase/
/Tools/MasterDatabase/*
!/Tools/MasterDatabase/SkillTree/
!/Tools/MasterDatabase/Affixes/
!/Tools/MasterDatabase/JSONs/

# Office lock files (open Excel workbooks)
~$*

# Python tooling noise (anywhere)
.venv/
__pycache__/
*.pyc
*.json.tmp
Tools/**/.idea/

# Local shader cache / local DDC variants (belt + suspenders)
**/DerivedDataCache/**
**/Intermediate/**
**/Saved/**

############################
# Unreal project files
############################
# If you want a code-only repo, ignore all assets:
Content/

# Optional: ignore local platform build products that sometimes appear
*.target
*.version

############################
# IDEs / tools
############################
.vs/
.idea/
.vscode/

# Rider / JetBrains
*.iml

# Visual Studio / MSBuild user files
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.VC.db
*.opendb
*.suo

############################
# Logs / crash / temp
############################
*.log
*.tmp
crashinfo*
*.dmp

############################
# OS junk
############################
Thumbs.db
.DS_Store
Desktop.ini

############################
# Auto-generated backups (e.g. import_tree_tags.py's
# agt.backup() writes these next to FP_GameplayTags.h/.cpp)
############################
*.bak_*

############################
# Keep these (do NOT ignore)
############################
# Config/*.ini should be committed (project settings)
# Source/** should be committed (code)
# *.uproject should be committed
